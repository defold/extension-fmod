      type: number
      desc: Timeout in milliseconds
  - name: get_network_timeout
    type: function
    desc: |
      Gets the network timeout of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: timeout
      type: userdata
      desc: The timeout value


  - name: set_user_data
    type: function
    desc: |
      Sets the user data of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: get_user_data
    type: function
    desc: |
      Gets the user data of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
- name: fmod.sound
  type: userdata
  desc: |
    A loaded audio sample or stream. Represents audio data that can be played on channels.

    See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
  notes: Must be released manually by calling release() when no longer needed.

  members:
  - name: release
    type: function
    desc: |
      Releases the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
  - name: get_system_object
    type: function
    desc: |
      Gets the system object of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: system
      type: userdata
      desc: The system value


  - name: lock
    type: function
    desc: |
      Locks the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
  - name: unlock
    type: function
    desc: |
      Unlocks the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
  - name: set_defaults
    type: function
    desc: |
      Sets the defaults of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: frequency
      type: number
      desc: Frequency in Hz
    - name: priority
      type: number
      desc: Priority (0 = highest, 256 = lowest)
  - name: get_defaults
    type: function
    desc: |
      Gets the defaults of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: frequency
      type: userdata
      desc: The frequency value

    - name: priority
      type: userdata
      desc: The priority value


  - name: set_3d_min_max_distance
    type: function
    desc: |
      Sets the 3 d min max distance of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: min
      type: number
      desc: min
    - name: max
      type: number
      desc: max
  - name: get_3d_min_max_distance
    type: function
    desc: |
      Gets the 3 d min max distance of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: min
      type: userdata
      desc: The min value

    - name: max
      type: userdata
      desc: The max value


  - name: set_3d_cone_settings
    type: function
    desc: |
      Sets the 3 d cone settings of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: insideconeangle
      type: number
      desc: Identifier
    - name: outsideconeangle
      type: number
      desc: Identifier
    - name: outsidevolume
      type: number
      desc: Volume level (0.0 to 1.0)
  - name: get_3d_cone_settings
    type: function
    desc: |
      Gets the 3 d cone settings of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: insideconeangle
      type: userdata
      desc: The insideconeangle value

    - name: outsideconeangle
      type: userdata
      desc: The outsideconeangle value

    - name: outsidevolume
      type: userdata
      desc: The outsidevolume value


  - name: set_3d_custom_rolloff
    type: function
    desc: |
      Sets the 3 d custom rolloff of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: numpoints
      type: number
      desc: numpoints
    returns:
    - name: points
      type: vector3
      desc: The points vector


  - name: get_3d_custom_rolloff
    type: function
    desc: |
      Gets the 3 d custom rolloff of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
  - name: get_sub_sound
    type: function
    desc: |
      Gets the sub sound of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: index
      type: number
      desc: Index value
    returns:
    - name: subsound
      type: userdata
      desc: The subsound value


  - name: get_sub_sound_parent
    type: function
    desc: |
      Gets the sub sound parent of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: parentsound
      type: userdata
      desc: The parentsound value


  - name: get_name
    type: function
    desc: |
      Gets the name of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
  - name: get_length
    type: function
    desc: |
      Gets the length of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: lengthtype
      type: number
      desc: Timeunit value
    returns:
    - name: length
      type: userdata
      desc: The length value


  - name: get_format
    type: function
    desc: |
      Gets the format of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: type
      type: userdata
      desc: The type value

    - name: format
      type: userdata
      desc: The format value

    - name: channels
      type: userdata
      desc: The channels value

    - name: bits
      type: userdata
      desc: The bits value


  - name: get_num_sub_sounds
    type: function
    desc: |
      Gets the num sub sounds of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: numsubsounds
      type: userdata
      desc: The numsubsounds value


  - name: get_num_tags
    type: function
    desc: |
      Gets the num tags of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: numtags
      type: userdata
      desc: The numtags value

    - name: numtagsupdated
      type: userdata
      desc: The numtagsupdated value


  - name: get_tag
    type: function
    desc: |
      Gets the tag of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: name
      type: string
      desc: Name or path
    - name: index
      type: number
      desc: Index value
    returns:
    - name: tag
      type: fmod.tag
      desc: The tag


  - name: get_open_state
    type: function
    desc: |
      Gets the open state of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: openstate
      type: userdata
      desc: The openstate value

    - name: percentbuffered
      type: userdata
      desc: The percentbuffered value

    - name: starving
      type: userdata
      desc: The starving value

    - name: diskbusy
      type: userdata
      desc: The diskbusy value


  - name: read_data
    type: function
    desc: |
      Reads data from the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
  - name: seek_data
    type: function
    desc: |
      Seeks to data in the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: pcm
      type: number
      desc: pcm
  - name: set_sound_group
    type: function
    desc: |
      Sets the sound group of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: soundgroup
      type: userdata
      desc: Sound group handle
  - name: get_sound_group
    type: function
    desc: |
      Gets the sound group of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: soundgroup
      type: userdata
      desc: The soundgroup value


  - name: get_num_sync_points
    type: function
    desc: |
      Gets the num sync points of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: numsyncpoints
      type: userdata
      desc: The numsyncpoints value


  - name: get_sync_point
    type: function
    desc: |
      Gets the sync point of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: index
      type: number
      desc: Index value
    returns:
    - name: point
      type: userdata
      desc: The point value


  - name: get_sync_point_info
    type: function
    desc: |
      Gets the sync point info of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
  - name: add_sync_point
    type: function
    desc: |
      Adds sync point to the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: offset
      type: number
      desc: offset
    - name: offsettype
      type: number
      desc: Timeunit value
    - name: name
      type: string
      desc: Name or path
    returns:
    - name: point
      type: userdata
      desc: The point value


  - name: delete_sync_point
    type: function
    desc: |
      Delete sync point on the sound.

          See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: point
      type: userdata
      desc: point
  - name: set_mode
    type: function
    desc: |
      Sets the mode of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: mode
      type: number
      desc: Mode flags
  - name: get_mode
    type: function
    desc: |
      Gets the mode of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: mode
      type: userdata
      desc: The mode value


  - name: set_loop_count
    type: function
    desc: |
      Sets the loop count of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: loopcount
      type: number
      desc: Loop count (-1 = infinite)
  - name: get_loop_count
    type: function
    desc: |
      Gets the loop count of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: loopcount
      type: userdata
      desc: The loopcount value


  - name: set_loop_points
    type: function
    desc: |
      Sets the loop points of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: loopstart
      type: number
      desc: Loop count (-1 = infinite)
    - name: loopstarttype
      type: number
      desc: Timeunit value
    - name: loopend
      type: number
      desc: Loop count (-1 = infinite)
    - name: loopendtype
      type: number
      desc: Timeunit value
  - name: get_loop_points
    type: function
    desc: |
      Gets the loop points of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: loopstarttype
      type: number
      desc: Timeunit value
    - name: loopendtype
      type: number
      desc: Timeunit value
    returns:
    - name: loopstart
      type: userdata
      desc: The loopstart value

    - name: loopend
      type: userdata
      desc: The loopend value


  - name: get_music_num_channels
    type: function
    desc: |
      Gets the music num channels of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: numchannels
      type: userdata
      desc: The numchannels value


  - name: set_music_channel_volume
    type: function
    desc: |
      Sets the music channel volume of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: channel
      type: number
      desc: Channel handle
    - name: volume
      type: number
      desc: Volume level (0.0 to 1.0)
  - name: get_music_channel_volume
    type: function
    desc: |
      Gets the music channel volume of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: channel
      type: number
      desc: Channel handle
    returns:
    - name: volume
      type: userdata
      desc: The volume value


  - name: set_music_speed
    type: function
    desc: |
      Sets the music speed of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    parameters:
    - name: speed
      type: number
      desc: speed
  - name: get_music_speed
    type: function
    desc: |
      Gets the music speed of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
    returns:
    - name: speed
      type: userdata
      desc: The speed value


  - name: set_user_data
    type: function
    desc: |
      Sets the user data of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
  - name: get_user_data
    type: function
    desc: |
      Gets the user data of the sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-sound.html).
- name: fmod.channelcontrol
  type: userdata
  desc: |
    Base interface shared by channels and channel groups for volume, pitch, and 3D control.

    See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelcontrol.html).

  members:
- name: fmod.channel
  type: userdata
  desc: |
    A playing instance of a sound. Owned by the system and cannot be released manually.

    See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
  notes: Owned by the system. Cannot be released manually.

  members:
  - name: get_system_object
    type: function
    desc: |
      Gets the system object of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: system
      type: userdata
      desc: The system value


  - name: stop
    type: function
    desc: |
      Stops the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
  - name: set_paused
    type: function
    desc: |
      Sets the paused of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: paused
      type: boolean
      desc: Paused state
  - name: get_paused
    type: function
    desc: |
      Gets the paused of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: paused
      type: userdata
      desc: The paused value


  - name: set_volume
    type: function
    desc: |
      Sets the volume of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: volume
      type: number
      desc: Volume level (0.0 to 1.0)
  - name: get_volume
    type: function
    desc: |
      Gets the volume of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: volume
      type: userdata
      desc: The volume value


  - name: set_volume_ramp
    type: function
    desc: |
      Sets the volume ramp of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: ramp
      type: boolean
      desc: Bool value
  - name: get_volume_ramp
    type: function
    desc: |
      Gets the volume ramp of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: ramp
      type: userdata
      desc: The ramp value


  - name: get_audibility
    type: function
    desc: |
      Gets the audibility of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: audibility
      type: userdata
      desc: The audibility value


  - name: set_pitch
    type: function
    desc: |
      Sets the pitch of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: pitch
      type: number
      desc: Pitch value (0.5 to 2.0)
  - name: get_pitch
    type: function
    desc: |
      Gets the pitch of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: pitch
      type: userdata
      desc: The pitch value


  - name: set_mute
    type: function
    desc: |
      Sets the mute of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: mute
      type: boolean
      desc: Bool value
  - name: get_mute
    type: function
    desc: |
      Gets the mute of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: mute
      type: userdata
      desc: The mute value


  - name: set_reverb_properties
    type: function
    desc: |
      Sets the reverb properties of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: instance
      type: number
      desc: instance
    - name: wet
      type: number
      desc: Wet mix level
  - name: get_reverb_properties
    type: function
    desc: |
      Gets the reverb properties of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: instance
      type: number
      desc: instance
    returns:
    - name: wet
      type: userdata
      desc: The wet value


  - name: set_low_pass_gain
    type: function
    desc: |
      Sets the low pass gain of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: gain
      type: number
      desc: Gain level in dB
  - name: get_low_pass_gain
    type: function
    desc: |
      Gets the low pass gain of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: gain
      type: userdata
      desc: The gain value


  - name: set_mode
    type: function
    desc: |
      Sets the mode of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: mode
      type: number
      desc: Mode flags
  - name: get_mode
    type: function
    desc: |
      Gets the mode of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: mode
      type: userdata
      desc: The mode value


  - name: set_callback
    type: function
    desc: |
      Sets the callback of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
  - name: is_playing
    type: function
    desc: |
      Returns whether the channel is playing.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: isplaying
      type: userdata
      desc: The isplaying value


  - name: set_pan
    type: function
    desc: |
      Sets the pan of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: pan
      type: number
      desc: Pan position (-1.0 left to 1.0 right)
  - name: set_mix_levels_output
    type: function
    desc: |
      Sets the mix levels output of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: frontleft
      type: number
      desc: frontleft
    - name: frontright
      type: number
      desc: frontright
    - name: center
      type: number
      desc: center
    - name: lfe
      type: number
      desc: lfe
    - name: surroundleft
      type: number
      desc: surroundleft
    - name: surroundright
      type: number
      desc: surroundright
    - name: backleft
      type: number
      desc: backleft
    - name: backright
      type: number
      desc: backright
  - name: set_mix_levels_input
    type: function
    desc: |
      Sets the mix levels input of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: numlevels
      type: number
      desc: Level value
    returns:
    - name: levels
      type: userdata
      desc: The levels value


  - name: set_mix_matrix
    type: function
    desc: |
      Sets the mix matrix of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: outchannels
      type: number
      desc: Channel handle
    - name: inchannels
      type: number
      desc: Channel handle
    - name: inchannel_hop
      type: number
      desc: Channel handle
    returns:
    - name: matrix
      type: userdata
      desc: The matrix value


  - name: get_mix_matrix
    type: function
    desc: |
      Gets the mix matrix of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: inchannel_hop
      type: number
      desc: Channel handle
    returns:
    - name: matrix
      type: userdata
      desc: The matrix value

    - name: outchannels
      type: userdata
      desc: The outchannels value

    - name: inchannels
      type: userdata
      desc: The inchannels value


  - name: get_dsp_clock
    type: function
    desc: |
      Gets the dsp clock of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: dspclock
      type: userdata
      desc: The dspclock value

    - name: parentclock
      type: userdata
      desc: The parentclock value


  - name: set_delay
    type: function
    desc: |
      Sets the delay of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: dspclock_start
      type: number
      desc: DSP handle
    - name: dspclock_end
      type: number
      desc: DSP handle
    - name: stopchannels
      type: boolean
      desc: Bool value
  - name: get_delay
    type: function
    desc: |
      Gets the delay of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: dspclock_start
      type: userdata
      desc: The dspclock_start value

    - name: dspclock_end
      type: userdata
      desc: The dspclock_end value

    - name: stopchannels
      type: userdata
      desc: The stopchannels value


  - name: add_fade_point
    type: function
    desc: |
      Adds fade point to the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: dspclock
      type: number
      desc: DSP handle
    - name: volume
      type: number
      desc: Volume level (0.0 to 1.0)
  - name: set_fade_point_ramp
    type: function
    desc: |
      Sets the fade point ramp of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: dspclock
      type: number
      desc: DSP handle
    - name: volume
      type: number
      desc: Volume level (0.0 to 1.0)
  - name: remove_fade_points
    type: function
    desc: |
      Removes fade points from the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: dspclock_start
      type: number
      desc: DSP handle
    - name: dspclock_end
      type: number
      desc: DSP handle
  - name: get_fade_points
    type: function
    desc: |
      Gets the fade points of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: numpoints
      type: userdata
      desc: The numpoints value

    - name: point_dspclock
      type: userdata
      desc: The point_dspclock value

    - name: point_volume
      type: userdata
      desc: The point_volume value


  - name: get_dsp
    type: function
    desc: |
      Gets the dsp of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: index
      type: number
      desc: Index value
    returns:
    - name: dsp
      type: userdata
      desc: The dsp value


  - name: add_dsp
    type: function
    desc: |
      Adds dsp to the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: index
      type: number
      desc: Index value
    - name: dsp
      type: userdata
      desc: DSP handle
  - name: remove_dsp
    type: function
    desc: |
      Removes dsp from the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: dsp
      type: userdata
      desc: DSP handle
  - name: get_num_ds_ps
    type: function
    desc: |
      Gets the num ds ps of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: numdsps
      type: userdata
      desc: The numdsps value


  - name: set_dsp_index
    type: function
    desc: |
      Sets the dsp index of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: dsp
      type: userdata
      desc: DSP handle
    - name: index
      type: number
      desc: Index value
  - name: get_dsp_index
    type: function
    desc: |
      Gets the dsp index of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: dsp
      type: userdata
      desc: DSP handle
    returns:
    - name: index
      type: userdata
      desc: The index value


  - name: set_3d_attributes
    type: function
    desc: |
      Sets the 3 d attributes of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: pos
      type: vector3
      desc: 3D position vector
    - name: vel
      type: vector3
      desc: 3D position vector
  - name: get_3d_attributes
    type: function
    desc: |
      Gets the 3 d attributes of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: pos
      type: vector3
      desc: The pos vector

    - name: vel
      type: vector3
      desc: The vel vector


  - name: set_3d_min_max_distance
    type: function
    desc: |
      Sets the 3 d min max distance of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: mindistance
      type: number
      desc: Minimum distance for 3D attenuation
    - name: maxdistance
      type: number
      desc: Maximum distance for 3D attenuation
  - name: get_3d_min_max_distance
    type: function
    desc: |
      Gets the 3 d min max distance of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: mindistance
      type: userdata
      desc: The mindistance value

    - name: maxdistance
      type: userdata
      desc: The maxdistance value


  - name: set_3d_cone_settings
    type: function
    desc: |
      Sets the 3 d cone settings of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: insideconeangle
      type: number
      desc: Identifier
    - name: outsideconeangle
      type: number
      desc: Identifier
    - name: outsidevolume
      type: number
      desc: Volume level (0.0 to 1.0)
  - name: get_3d_cone_settings
    type: function
    desc: |
      Gets the 3 d cone settings of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: insideconeangle
      type: userdata
      desc: The insideconeangle value

    - name: outsideconeangle
      type: userdata
      desc: The outsideconeangle value

    - name: outsidevolume
      type: userdata
      desc: The outsidevolume value


  - name: set_3d_cone_orientation
    type: function
    desc: |
      Sets the 3 d cone orientation of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: orientation
      type: vector3
      desc: The orientation vector


  - name: get_3d_cone_orientation
    type: function
    desc: |
      Gets the 3 d cone orientation of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: orientation
      type: vector3
      desc: The orientation vector


  - name: set_3d_custom_rolloff
    type: function
    desc: |
      Sets the 3 d custom rolloff of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: numpoints
      type: number
      desc: numpoints
    returns:
    - name: points
      type: vector3
      desc: The points vector


  - name: get_3d_custom_rolloff
    type: function
    desc: |
      Gets the 3 d custom rolloff of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
  - name: set_3d_occlusion
    type: function
    desc: |
      Sets the 3 d occlusion of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: directocclusion
      type: number
      desc: directocclusion
    - name: reverbocclusion
      type: number
      desc: Reverb handle
  - name: get_3d_occlusion
    type: function
    desc: |
      Gets the 3 d occlusion of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: directocclusion
      type: userdata
      desc: The directocclusion value

    - name: reverbocclusion
      type: userdata
      desc: The reverbocclusion value


  - name: set_3d_spread
    type: function
    desc: |
      Sets the 3 d spread of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: angle
      type: number
      desc: Angle in degrees
  - name: get_3d_spread
    type: function
    desc: |
      Gets the 3 d spread of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: angle
      type: userdata
      desc: The angle value


  - name: set_3d_level
    type: function
    desc: |
      Sets the 3 d level of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    parameters:
    - name: level
      type: number
