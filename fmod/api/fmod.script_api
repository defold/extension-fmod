    - name: proxy
      type: string
      desc: proxy
  - name: get_network_proxy
    type: function
    desc: |
      Gets the network proxy of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: set_network_timeout
    type: function
    desc: |
      Sets the network timeout of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
