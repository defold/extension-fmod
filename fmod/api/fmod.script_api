  - name: get_index
    type: function
    desc: |
      Gets the index of the channel.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channel.html).
    returns:
    - name: index
      type: userdata
      desc: The index value


- name: fmod.channelgroup
  type: userdata
  desc: |
    A group of channels. Used for submixing, organizing audio, and applying shared effects.

    See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
  notes: Must be released manually by calling release() when no longer needed.

  members:
  - name: get_system_object
    type: function
    desc: |
      Gets the system object of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: system
      type: userdata
      desc: The system value


  - name: stop
    type: function
    desc: |
      Stops the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
  - name: set_paused
    type: function
    desc: |
      Sets the paused of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: paused
      type: boolean
      desc: Paused state
  - name: get_paused
    type: function
    desc: |
      Gets the paused of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: paused
      type: userdata
      desc: The paused value


  - name: set_volume
    type: function
    desc: |
      Sets the volume of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: volume
      type: number
      desc: Volume level (0.0 to 1.0)
  - name: get_volume
    type: function
    desc: |
      Gets the volume of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: volume
      type: userdata
      desc: The volume value


  - name: set_volume_ramp
    type: function
    desc: |
      Sets the volume ramp of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: ramp
      type: boolean
      desc: Bool value
  - name: get_volume_ramp
    type: function
    desc: |
      Gets the volume ramp of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: ramp
      type: userdata
      desc: The ramp value


  - name: get_audibility
    type: function
    desc: |
      Gets the audibility of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: audibility
      type: userdata
      desc: The audibility value


  - name: set_pitch
    type: function
    desc: |
      Sets the pitch of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: pitch
      type: number
      desc: Pitch value (0.5 to 2.0)
  - name: get_pitch
    type: function
    desc: |
      Gets the pitch of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: pitch
      type: userdata
      desc: The pitch value


  - name: set_mute
    type: function
    desc: |
      Sets the mute of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: mute
      type: boolean
      desc: Bool value
  - name: get_mute
    type: function
    desc: |
      Gets the mute of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: mute
      type: userdata
      desc: The mute value


  - name: set_reverb_properties
    type: function
    desc: |
      Sets the reverb properties of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: instance
      type: number
      desc: instance
    - name: wet
      type: number
      desc: Wet mix level
  - name: get_reverb_properties
    type: function
    desc: |
      Gets the reverb properties of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: instance
      type: number
      desc: instance
    returns:
    - name: wet
      type: userdata
      desc: The wet value


  - name: set_low_pass_gain
    type: function
    desc: |
      Sets the low pass gain of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: gain
      type: number
      desc: Gain level in dB
  - name: get_low_pass_gain
    type: function
    desc: |
      Gets the low pass gain of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: gain
      type: userdata
      desc: The gain value


  - name: set_mode
    type: function
    desc: |
      Sets the mode of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: mode
      type: number
      desc: Mode flags
  - name: get_mode
    type: function
    desc: |
      Gets the mode of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: mode
      type: userdata
      desc: The mode value


  - name: set_callback
    type: function
    desc: |
      Sets the callback of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
