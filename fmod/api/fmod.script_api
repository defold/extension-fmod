      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: id
      type: number
      desc: Identifier
    returns:
    - name: recording
      type: userdata
      desc: The recording value


  - name: create_geometry
    type: function
    desc: |
      Creates a new geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: maxpolygons
      type: number
      desc: maxpolygons
    - name: maxvertices
      type: number
      desc: maxvertices
    returns:
    - name: geometry
      type: userdata
      desc: The geometry value


  - name: set_geometry_settings
    type: function
    desc: |
      Sets the geometry settings of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: maxworldsize
      type: number
      desc: Size in bytes
  - name: get_geometry_settings
    type: function
    desc: |
      Gets the geometry settings of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
