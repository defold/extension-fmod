      type: fmod.reverb_properties
      desc: The properties


  - name: lock_dsp
    type: function
    desc: |
      Lock dsp on the system.

          See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: unlock_dsp
    type: function
    desc: |
      Unlock dsp on the system.

          See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: get_record_num_drivers
    type: function
    desc: |
      Gets the record num drivers of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: numdrivers
      type: userdata
      desc: The numdrivers value

    - name: numconnected
      type: userdata
      desc: The numconnected value


  - name: get_record_driver_info
    type: function
    desc: |
      Gets the record driver info of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: get_record_position
    type: function
    desc: |
      Gets the record position of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: id
      type: number
      desc: Identifier
