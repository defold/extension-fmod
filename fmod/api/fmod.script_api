    desc: |
      Adds fade point to the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: dspclock
      type: number
      desc: DSP handle
    - name: volume
      type: number
      desc: Volume level (0.0 to 1.0)
  - name: set_fade_point_ramp
    type: function
    desc: |
      Sets the fade point ramp of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: dspclock
      type: number
      desc: DSP handle
    - name: volume
      type: number
      desc: Volume level (0.0 to 1.0)
  - name: remove_fade_points
    type: function
    desc: |
      Removes fade points from the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: dspclock_start
      type: number
      desc: DSP handle
