      type: number
      desc: Channel handle
    - name: inchannel_hop
      type: number
      desc: Channel handle
    returns:
    - name: matrix
      type: userdata
      desc: The matrix value


  - name: get_mix_matrix
    type: function
    desc: |
      Gets the mix matrix of the dspconnection.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-dspconnection.html).
    parameters:
    - name: inchannel_hop
      type: number
      desc: Channel handle
    returns:
