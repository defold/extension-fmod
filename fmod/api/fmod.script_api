      type: number
      desc: Index value
    - name: dsp
      type: userdata
      desc: DSP handle
  - name: remove_dsp
    type: function
    desc: |
      Removes dsp from the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: dsp
      type: userdata
      desc: DSP handle
  - name: get_num_ds_ps
    type: function
    desc: |
      Gets the num ds ps of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: numdsps
      type: userdata
      desc: The numdsps value


  - name: set_dsp_index
    type: function
    desc: |
      Sets the dsp index of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
