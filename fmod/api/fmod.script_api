- name: fmod.geometry
  type: userdata
  desc: |
    A geometry object for occlusion-based 3D audio.

    See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
  notes: Must be released manually by calling release() when no longer needed.

  members:
  - name: release
    type: function
    desc: |
      Releases the geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
  - name: add_polygon
    type: function
    desc: |
      Adds polygon to the geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
    parameters:
    - name: directocclusion
      type: number
      desc: directocclusion
    - name: reverbocclusion
      type: number
      desc: Reverb handle
    - name: doublesided
      type: boolean
      desc: Bool value
    - name: numvertices
      type: number
      desc: numvertices
    - name: vertices
      type: vector3
      desc: 3D position vector
    returns:
    - name: polygonindex
      type: userdata
      desc: The polygonindex value


  - name: get_num_polygons
    type: function
    desc: |
      Gets the num polygons of the geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
    returns:
    - name: numpolygons
      type: userdata
      desc: The numpolygons value


  - name: get_max_polygons
    type: function
    desc: |
      Gets the max polygons of the geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
    returns:
    - name: maxpolygons
      type: userdata
      desc: The maxpolygons value

    - name: maxvertices
      type: userdata
      desc: The maxvertices value


  - name: get_polygon_num_vertices
    type: function
    desc: |
      Gets the polygon num vertices of the geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
    parameters:
    - name: index
      type: number
      desc: Index value
    returns:
    - name: numvertices
      type: userdata
      desc: The numvertices value


  - name: set_polygon_vertex
    type: function
    desc: |
      Sets the polygon vertex of the geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
    parameters:
    - name: index
      type: number
      desc: Index value
    - name: vertexindex
      type: number
      desc: Index value
    - name: vertex
      type: vector3
      desc: 3D position vector
  - name: get_polygon_vertex
    type: function
    desc: |
      Gets the polygon vertex of the geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
    parameters:
    - name: index
      type: number
      desc: Index value
    - name: vertexindex
      type: number
      desc: Index value
    returns:
    - name: vertex
      type: vector3
      desc: The vertex vector


  - name: set_polygon_attributes
    type: function
    desc: |
      Sets the polygon attributes of the geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
    parameters:
    - name: index
      type: number
      desc: Index value
    - name: directocclusion
      type: number
      desc: directocclusion
    - name: reverbocclusion
      type: number
      desc: Reverb handle
    - name: doublesided
      type: boolean
      desc: Bool value
  - name: get_polygon_attributes
    type: function
    desc: |
      Gets the polygon attributes of the geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
    parameters:
    - name: index
      type: number
      desc: Index value
    returns:
    - name: directocclusion
      type: userdata
      desc: The directocclusion value

    - name: reverbocclusion
      type: userdata
      desc: The reverbocclusion value

    - name: doublesided
      type: userdata
      desc: The doublesided value


  - name: set_active
    type: function
    desc: |
      Sets the active of the geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
    parameters:
    - name: active
      type: boolean
      desc: Bool value
  - name: get_active
    type: function
    desc: |
      Gets the active of the geometry.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-geometry.html).
    returns:
    - name: active
      type: userdata
      desc: The active value


  - name: set_rotation
    type: function
