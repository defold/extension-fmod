      type: number
      desc: DSP handle
  - name: get_fade_points
    type: function
    desc: |
      Gets the fade points of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: numpoints
      type: userdata
      desc: The numpoints value

    - name: point_dspclock
      type: userdata
      desc: The point_dspclock value

    - name: point_volume
      type: userdata
      desc: The point_volume value


  - name: get_dsp
    type: function
    desc: |
      Gets the dsp of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: index
      type: number
      desc: Index value
    returns:
    - name: dsp
      type: userdata
      desc: The dsp value


  - name: add_dsp
    type: function
    desc: |
      Adds dsp to the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
