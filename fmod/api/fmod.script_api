    type: function
    desc: |
      Returns whether the channelgroup is playing.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: isplaying
      type: userdata
      desc: The isplaying value


  - name: set_pan
    type: function
    desc: |
      Sets the pan of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: pan
      type: number
      desc: Pan position (-1.0 left to 1.0 right)
  - name: set_mix_levels_output
    type: function
    desc: |
      Sets the mix levels output of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: frontleft
      type: number
      desc: frontleft
    - name: frontright
      type: number
      desc: frontright
    - name: center
      type: number
      desc: center
    - name: lfe
      type: number
      desc: lfe
    - name: surroundleft
      type: number
      desc: surroundleft
    - name: surroundright
      type: number
      desc: surroundright
    - name: backleft
      type: number
      desc: backleft
    - name: backright
      type: number
      desc: backright
  - name: set_mix_levels_input
    type: function
    desc: |
      Sets the mix levels input of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: numlevels
      type: number
      desc: Level value
    returns:
    - name: levels
      type: userdata
      desc: The levels value


  - name: set_mix_matrix
    type: function
    desc: |
      Sets the mix matrix of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: outchannels
      type: number
      desc: Channel handle
    - name: inchannels
      type: number
      desc: Channel handle
    - name: inchannel_hop
      type: number
      desc: Channel handle
    returns:
    - name: matrix
      type: userdata
      desc: The matrix value


  - name: get_mix_matrix
    type: function
    desc: |
      Gets the mix matrix of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: inchannel_hop
      type: number
      desc: Channel handle
    returns:
    - name: matrix
      type: userdata
      desc: The matrix value

    - name: outchannels
      type: userdata
      desc: The outchannels value

    - name: inchannels
      type: userdata
      desc: The inchannels value


  - name: get_dsp_clock
    type: function
    desc: |
      Gets the dsp clock of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: dspclock
      type: userdata
      desc: The dspclock value

    - name: parentclock
      type: userdata
      desc: The parentclock value


  - name: set_delay
    type: function
    desc: |
      Sets the delay of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    parameters:
    - name: dspclock_start
      type: number
      desc: DSP handle
    - name: dspclock_end
      type: number
      desc: DSP handle
    - name: stopchannels
      type: boolean
      desc: Bool value
  - name: get_delay
    type: function
    desc: |
      Gets the delay of the channelgroup.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-channelgroup.html).
    returns:
    - name: dspclock_start
