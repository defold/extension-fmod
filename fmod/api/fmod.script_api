      type: userdata
      desc: The bytes read value


  - name: create_sound
    type: function
    desc: |
      Creates a new sound.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: name_or_data
      type: string
      desc: Name or path
    - name: mode
      type: number
      desc: Mode flags
    - name: exinfo
      type: userdata
      desc: exinfo (optional)
    returns:
    - name: sound
      type: userdata
      desc: The sound value


  - name: create_stream
    type: function
    desc: |
      Creates a new stream.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: name_or_data
      type: string
