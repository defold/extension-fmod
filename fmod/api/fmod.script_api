#*****************************************************************************************************

  - name: memory_initialize
    type: function
    desc: |
      Initialize for memory.

  - name: memory_get_stats
    type: function
    desc: |
      Get stats for memory.
    parameters:
    - name: blocking
      type: boolean
      desc: Bool value
    returns:
    - name: currentalloced
      type: userdata
      desc: The currentalloced value

    - name: maxalloced
      type: userdata
      desc: The maxalloced value


  - name: debug_initialize
    type: function
    desc: |
      Initialize for debug.

  - name: file_set_disk_busy
    type: function
    desc: |
      Set disk busy for file.
    parameters:
    - name: busy
      type: number
      desc: Bus handle

  - name: file_get_disk_busy
    type: function
    desc: |
      Get disk busy for file.
    returns:
    - name: busy
      type: userdata
      desc: The busy value


  - name: thread_set_attributes
    type: function
    desc: |
      Set attributes for thread.
    parameters:
    - name: type
      type: number
      desc: Type value
    - name: affinity
      type: number
      desc: Affinity value
    - name: priority
      type: number
      desc: Priority (0 = highest, 256 = lowest)
    - name: stacksize
      type: number
      desc: Size value

  - name: system_create
    type: function
    desc: |
      Create for system.
    parameters:
    - name: headerversion
      type: number
      desc: headerversion
    returns:
    - name: system
      type: userdata
      desc: The system value



#*****************************************************************************************************

  - name: system
    type: fmod.system
    desc: The FMOD low-level system instance

  - name: error_code
    type: table
    desc: Table mapping error messages to error codes

  - name: s64
    type: function
    desc: Creates a signed 64-bit integer value
    parameters:
    - name: value
      type: number
      desc: The value (or low 32 bits if high is provided)
    - name: high
      type: number
      desc: The high 32 bits (optional)
    returns:
    - name: value
      type: userdata
      desc: The 64-bit integer value

  - name: u64
    type: function
    desc: Creates an unsigned 64-bit integer value
    parameters:
    - name: value
      type: number
      desc: The value (or low 32 bits if high is provided)
    - name: high
      type: number
      desc: The high 32 bits (optional)
    returns:
    - name: value
      type: userdata
      desc: The 64-bit integer value

#*****************************************************************************************************

- name: fmod.system
  type: userdata
  desc: |
    The core FMOD system object. Handles device enumeration, audio output, channel management, and DSP processing.

    See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).

  members:
  - name: release
    type: function
    desc: |
      Releases the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: set_output
    type: function
    desc: |
      Sets the output of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: output
      type: number
      desc: Output type
  - name: get_output
    type: function
    desc: |
      Gets the output of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: output
      type: userdata
      desc: The output value


  - name: get_num_drivers
    type: function
    desc: |
      Gets the num drivers of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: numdrivers
      type: userdata
      desc: The numdrivers value


  - name: get_driver_info
    type: function
    desc: |
      Gets the driver info of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: set_driver
    type: function
    desc: |
      Sets the driver of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: driver
      type: number
      desc: Driver index
  - name: get_driver
    type: function
    desc: |
      Gets the driver of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: driver
      type: userdata
      desc: The driver value


  - name: set_software_channels
    type: function
    desc: |
      Sets the software channels of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: numsoftwarechannels
      type: number
      desc: Channel handle
  - name: get_software_channels
    type: function
    desc: |
      Gets the software channels of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: numsoftwarechannels
      type: userdata
      desc: The numsoftwarechannels value


  - name: set_software_format
    type: function
    desc: |
      Sets the software format of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: samplerate
      type: number
      desc: Sample rate in Hz
    - name: speakermode
      type: number
      desc: Speaker mode value
    - name: numrawspeakers
      type: number
      desc: numrawspeakers
  - name: get_software_format
    type: function
    desc: |
      Gets the software format of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: samplerate
      type: userdata
      desc: The samplerate value

    - name: speakermode
      type: userdata
      desc: The speakermode value

    - name: numrawspeakers
      type: userdata
      desc: The numrawspeakers value


  - name: set_dsp_buffer_size
    type: function
    desc: |
      Sets the dsp buffer size of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: bufferlength
      type: number
      desc: Buffer length in samples
    - name: numbuffers
      type: number
      desc: Number of buffers
  - name: get_dsp_buffer_size
    type: function
    desc: |
      Gets the dsp buffer size of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: bufferlength
      type: userdata
      desc: The bufferlength value

    - name: numbuffers
      type: userdata
      desc: The numbuffers value


  - name: set_file_system
    type: function
    desc: |
      Sets the file system of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: attach_file_system
    type: function
    desc: |
      Attach file system on the system.

          See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: set_advanced_settings
    type: function
    desc: |
      Sets the advanced settings of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: settings
      type: fmod.advancedsettings
      desc: The advancedsettings


  - name: get_advanced_settings
    type: function
    desc: |
      Gets the advanced settings of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: settings
      type: fmod.advancedsettings
      desc: The advancedsettings


  - name: set_callback
    type: function
    desc: |
      Sets the callback of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: set_plugin_path
    type: function
    desc: |
      Sets the plugin path of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: path
      type: string
      desc: Path string
  - name: load_plugin
    type: function
    desc: |
      Loads a plugin.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: filename
      type: string
      desc: File path
    - name: priority
      type: number
      desc: Priority (0 = highest, 256 = lowest)
    returns:
    - name: handle
      type: userdata
      desc: The handle value


  - name: unload_plugin
    type: function
    desc: |
      Unloads a plugin.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: handle
      type: number
      desc: handle
  - name: get_num_nested_plugins
    type: function
    desc: |
      Gets the num nested plugins of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: handle
      type: number
      desc: handle
    returns:
    - name: count
      type: userdata
      desc: The count value


  - name: get_nested_plugin
    type: function
    desc: |
      Gets the nested plugin of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: handle
      type: number
      desc: handle
    - name: index
      type: number
      desc: Index value
    returns:
    - name: nestedhandle
      type: userdata
      desc: The nestedhandle value


  - name: get_num_plugins
    type: function
    desc: |
      Gets the num plugins of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: plugintype
      type: number
      desc: Plugintype value
    returns:
    - name: numplugins
      type: userdata
      desc: The numplugins value


  - name: get_plugin_handle
    type: function
    desc: |
      Gets the plugin handle of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: plugintype
      type: number
      desc: Plugintype value
    - name: index
      type: number
      desc: Index value
    returns:
    - name: handle
      type: userdata
      desc: The handle value


  - name: get_plugin_info
    type: function
    desc: |
      Gets the plugin info of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: set_output_by_plugin
    type: function
    desc: |
      Sets the output by plugin of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: handle
      type: number
      desc: handle
  - name: get_output_by_plugin
    type: function
    desc: |
      Gets the output by plugin of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: handle
      type: userdata
      desc: The handle value


  - name: create_dsp_by_plugin
    type: function
    desc: |
      Creates a new dsp by plugin.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: handle
      type: number
      desc: handle
    returns:
    - name: dsp
      type: userdata
      desc: The dsp value


  - name: get_dsp_info_by_plugin
    type: function
    desc: |
      Gets the dsp info by plugin of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: handle
      type: number
      desc: handle
    returns:
    - name: description
      type: userdata
      desc: The description value


  - name: register_codec
    type: function
    desc: |
      Register codec on the system.

          See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: priority
      type: number
      desc: Priority (0 = highest, 256 = lowest)
    returns:
    - name: description
      type: fmod.codec_description
      desc: The description

    - name: handle
      type: userdata
      desc: The handle value


  - name: register_dsp
    type: function
    desc: |
      Register dsp on the system.

          See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: description
      type: userdata
      desc: Description string
    returns:
    - name: handle
      type: userdata
      desc: The handle value


  - name: register_output
    type: function
    desc: |
      Register output on the system.

          See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: description
      type: userdata
      desc: Description string
    returns:
    - name: handle
      type: userdata
      desc: The handle value


  - name: init
    type: function
    desc: |
      Initializes the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: close
    type: function
    desc: |
      Closes the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: update
    type: function
    desc: |
      Updates the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: set_speaker_position
    type: function
    desc: |
      Sets the speaker position of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: speaker
      type: number
      desc: Speaker value
    - name: x
      type: number
      desc: x
    - name: y
      type: number
      desc: y
    - name: active
      type: boolean
      desc: Bool value
  - name: get_speaker_position
    type: function
    desc: |
      Gets the speaker position of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: speaker
      type: number
      desc: Speaker value
    returns:
    - name: x
      type: userdata
      desc: The x value

    - name: y
      type: userdata
      desc: The y value

    - name: active
      type: userdata
      desc: The active value


  - name: set_stream_buffer_size
    type: function
    desc: |
      Sets the stream buffer size of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: filebuffersize
      type: number
      desc: Size in bytes
    - name: filebuffersizetype
      type: number
      desc: Timeunit value
  - name: get_stream_buffer_size
    type: function
    desc: |
      Gets the stream buffer size of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: filebuffersize
      type: userdata
      desc: The filebuffersize value

    - name: filebuffersizetype
      type: userdata
      desc: The filebuffersizetype value


  - name: set_3d_settings
    type: function
    desc: |
      Sets the 3 d settings of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: dopplerscale
      type: number
      desc: dopplerscale
    - name: distancefactor
      type: number
      desc: distancefactor
    - name: rolloffscale
      type: number
      desc: rolloffscale
  - name: get_3d_settings
    type: function
    desc: |
      Gets the 3 d settings of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: dopplerscale
      type: userdata
      desc: The dopplerscale value

    - name: distancefactor
      type: userdata
      desc: The distancefactor value

    - name: rolloffscale
      type: userdata
      desc: The rolloffscale value


  - name: set_3d_num_listeners
    type: function
    desc: |
      Sets the 3 d num listeners of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: numlisteners
      type: number
      desc: numlisteners
  - name: get_3d_num_listeners
    type: function
    desc: |
      Gets the 3 d num listeners of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    returns:
    - name: numlisteners
      type: userdata
      desc: The numlisteners value


  - name: set_3d_listener_attributes
    type: function
    desc: |
      Sets the 3 d listener attributes of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: listener
      type: number
      desc: listener
    - name: pos
      type: vector3
      desc: 3D position vector
    - name: vel
      type: vector3
      desc: 3D position vector
    - name: forward
      type: vector3
      desc: Forward orientation vector
    - name: up
      type: vector3
      desc: Up orientation vector
  - name: get_3d_listener_attributes
    type: function
    desc: |
      Gets the 3 d listener attributes of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: listener
      type: number
      desc: listener
    returns:
    - name: pos
      type: vector3
      desc: The pos vector

    - name: vel
      type: vector3
      desc: The vel vector

    - name: forward
      type: vector3
      desc: The forward vector

    - name: up
      type: vector3
      desc: The up vector


  - name: set_3d_rolloff_callback
    type: function
    desc: |
      Sets the 3 d rolloff callback of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: mixer_suspend
    type: function
    desc: |
      Mixer suspend on the system.

          See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
  - name: mixer_resume
    type: function
    desc: |
