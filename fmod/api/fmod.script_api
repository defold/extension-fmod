- name: fmod.studio.system
  type: userdata
  desc: |
    The FMOD Studio system object. Manages banks, events, buses, and the Studio runtime.

    See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).

  members:
  - name: is_valid
    type: function
    desc: |
      Returns whether the system is valid.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
  - name: set_advanced_settings
    type: function
    desc: |
      Sets the advanced settings of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    returns:
    - name: settings
      type: fmod.studio.advancedsettings
      desc: The advancedsettings


  - name: get_advanced_settings
    type: function
    desc: |
      Gets the advanced settings of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    returns:
    - name: settings
      type: fmod.studio.advancedsettings
      desc: The advancedsettings


  - name: initialize
    type: function
    desc: |
      Initializes the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
  - name: release
    type: function
    desc: |
      Releases the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
  - name: update
    type: function
    desc: |
      Updates the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
  - name: get_core_system
    type: function
    desc: |
      Gets the core system of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    returns:
    - name: coresystem
      type: userdata
      desc: The coresystem value


  - name: get_event
    type: function
    desc: |
      Gets the event of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    parameters:
    - name: pathOrID
      type: string
      desc: Path string
    returns:
    - name: event
      type: userdata
      desc: The event value


  - name: get_bus
    type: function
    desc: |
      Gets the bus of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    parameters:
    - name: pathOrID
      type: string
      desc: Path string
    returns:
    - name: bus
      type: userdata
      desc: The bus value


  - name: get_vca
    type: function
    desc: |
      Gets the vca of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    parameters:
    - name: pathOrID
      type: string
      desc: Path string
    returns:
    - name: vca
      type: userdata
      desc: The vca value


  - name: get_bank
    type: function
    desc: |
      Gets the bank of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    parameters:
    - name: pathOrID
      type: string
      desc: Path string
    returns:
    - name: bank
      type: userdata
      desc: The bank value


  - name: get_event_by_id
    type: function
    desc: |
      Gets the event by id of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    parameters:
    - name: id
      type: userdata
      desc: Identifier
    returns:
    - name: event
      type: userdata
      desc: The event value


  - name: get_bus_by_id
    type: function
    desc: |
      Gets the bus by id of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    parameters:
    - name: id
      type: userdata
      desc: Identifier
    returns:
    - name: bus
      type: userdata
      desc: The bus value


  - name: get_vca_by_id
    type: function
    desc: |
      Gets the vca by id of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    parameters:
    - name: id
      type: userdata
      desc: Identifier
    returns:
    - name: vca
      type: userdata
      desc: The vca value


  - name: get_bank_by_id
    type: function
    desc: |
      Gets the bank by id of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    parameters:
    - name: id
      type: userdata
      desc: Identifier
    returns:
    - name: bank
      type: userdata
      desc: The bank value


  - name: get_sound_info
    type: function
    desc: |
      Gets the sound info of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    parameters:
    - name: key
      type: string
      desc: key
    returns:
    - name: info
      type: fmod.studio.sound_info
      desc: The info


  - name: get_parameter_description_by_name
    type: function
    desc: |
      Gets the parameter description by name of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    parameters:
    - name: name
      type: string
      desc: Name or path
    returns:
    - name: parameter
      type: fmod.studio.parameter_description
      desc: The description


  - name: get_parameter_description_by_id
    type: function
    desc: |
      Gets the parameter description by id of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/studio-api-system.html).
    parameters:
