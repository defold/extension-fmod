    - name: position
      type: userdata
      desc: The position value


  - name: record_start
    type: function
    desc: |
      Record start on the system.

          See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: id
      type: number
      desc: Identifier
    - name: sound
      type: userdata
      desc: Sound handle
    - name: loop
      type: boolean
      desc: Loop count (-1 = infinite)
  - name: record_stop
    type: function
    desc: |
      Record stop on the system.

          See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: id
      type: number
      desc: Identifier
