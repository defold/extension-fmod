    type: function
    desc: |
      Sets the reverb properties of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: instance
      type: number
      desc: instance
    - name: prop
      type: userdata
      desc: prop
  - name: get_reverb_properties
    type: function
    desc: |
      Gets the reverb properties of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
    parameters:
    - name: instance
      type: number
      desc: instance
    returns:
