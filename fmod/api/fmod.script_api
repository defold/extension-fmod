      type: vector3
      desc: 3D position vector
    - name: source
      type: vector3
      desc: 3D position vector
    returns:
    - name: direct
      type: userdata
      desc: The direct value

    - name: reverb
      type: userdata
      desc: The reverb value


  - name: set_network_proxy
    type: function
    desc: |
      Sets the network proxy of the system.

      See [FMOD docs](https://www.fmod.com/docs/2.03/api/core-api-system.html).
