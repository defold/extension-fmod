-- State name mapping for display
local STATE_NAMES = {
	[0] = "PLAYING",
	[1] = "SUSTAINING",
	[2] = "STOPPED",
	[3] = "STARTING",
	[4] = "STOPPING"
}

-- Button color definitions
local COLORS = {
	start_normal = vmath.vector4(0.3, 0.8, 0.3, 1.0),
	start_pressed = vmath.vector4(0.4, 1.0, 0.4, 1.0),
	stop_normal = vmath.vector4(0.8, 0.3, 0.3, 1.0),
	stop_pressed = vmath.vector4(1.0, 0.4, 0.4, 1.0),
	pause_normal = vmath.vector4(0.8, 0.8, 0.3, 1.0),
	pause_pressed = vmath.vector4(1.0, 1.0, 0.4, 1.0),
	disabled = vmath.vector4(0.5, 0.5, 0.5, 0.5)
}

function init(self)
	msg.post(".", "acquire_input_focus")

	-- Get all button nodes
	self.button_start_instant = gui.get_node("button_start_instant")
	self.button_stop_instant = gui.get_node("button_stop_instant")
	self.button_stop_fade = gui.get_node("button_stop_fade")
	self.button_pause = gui.get_node("button_pause")

	-- Get text nodes
	self.text_pause = gui.get_node("text_pause")
	self.label_state = gui.get_node("label_state")
	self.label_paused = gui.get_node("label_paused")
	self.panel_background = gui.get_node("panel_background")

	-- State tracking
	self.current_state = 2  -- Start as STOPPED
	self.is_paused = false

	-- Polling timer (50ms = 20 Hz)
	self.poll_timer = 0
	self.poll_interval = 0.05

	-- Track pressed button for visual feedback
	self.pressed_button = nil

	-- Initial state display
	update_state_display(self)
	update_button_states(self)
end

function update(self, dt)
	-- Poll for state updates every 50ms
	self.poll_timer = self.poll_timer + dt
	if self.poll_timer >= self.poll_interval then
		self.poll_timer = 0
		msg.post("example_1:/listener", "fmod_query_state", {})
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("fmod_state_update") then
		self.current_state = message.playback_state
		self.is_paused = message.is_paused
		update_state_display(self)
		update_button_states(self)
	end
end

function on_input(self, action_id, action)
	if action_id == hash("click") then
		-- Check if click is on the panel at all (to consume input)
		local panel_hit = gui.pick_node(self.panel_background, action.x, action.y)

		if panel_hit then
			if action.pressed then
				-- Check each button
				if gui.pick_node(self.button_start_instant, action.x, action.y) then
					gui.set_color(self.button_start_instant, COLORS.start_pressed)
					self.pressed_button = self.button_start_instant
					send_control("start_instant")
				elseif gui.pick_node(self.button_stop_instant, action.x, action.y) then
					gui.set_color(self.button_stop_instant, COLORS.stop_pressed)
					self.pressed_button = self.button_stop_instant
					send_control("stop_instant")
				elseif gui.pick_node(self.button_stop_fade, action.x, action.y) then
					gui.set_color(self.button_stop_fade, COLORS.stop_pressed)
					self.pressed_button = self.button_stop_fade
					send_control("stop_fade")
				elseif gui.pick_node(self.button_pause, action.x, action.y) then
					gui.set_color(self.button_pause, COLORS.pause_pressed)
					self.pressed_button = self.button_pause
					send_control("toggle_pause")
				end
			end

			if action.released and self.pressed_button then
				-- Reset button color on release
				update_button_states(self)
				self.pressed_button = nil
			end

			-- Consume ALL click events (pressed, released, repeated) on the panel
			-- print("GUI: Consuming click - NOT forwarding to game")
			return true
		else
			-- Click/drag is outside panel - forward to game script for source movement
			msg.post("example_1:/listener", "click_outside_ui", {
				x = action.x,
				y = action.y,
				pressed = action.pressed,
				released = action.released
			})
			-- Still consume the click to prevent game script from also handling it
			return true
		end
	end

	return false
end

-- Helper Functions

function update_state_display(self)
	local state_text = "State: " .. (STATE_NAMES[self.current_state] or "UNKNOWN")
	local paused_text = "Paused: " .. (self.is_paused and "Yes" or "No")

	gui.set_text(self.label_state, state_text)
	gui.set_text(self.label_paused, paused_text)
end

function update_button_states(self)
	-- Determine which buttons should be enabled
	local can_start = (self.current_state == 2 or self.current_state == 4)  -- STOPPED or STOPPING
	local can_stop = (self.current_state == 0 or self.current_state == 1 or self.current_state == 3)  -- PLAYING, SUSTAINING, or STARTING
	local can_pause = (self.current_state == 0 or self.current_state == 1)  -- PLAYING or SUSTAINING

	-- Update start button
	if can_start then
		gui.set_color(self.button_start_instant, COLORS.start_normal)
	else
		gui.set_color(self.button_start_instant, COLORS.disabled)
	end

	-- Update stop buttons
	if can_stop then
		gui.set_color(self.button_stop_instant, COLORS.stop_normal)
		gui.set_color(self.button_stop_fade, COLORS.stop_normal)
	else
		gui.set_color(self.button_stop_instant, COLORS.disabled)
		gui.set_color(self.button_stop_fade, COLORS.disabled)
	end

	-- Update pause button and label
	if can_pause then
		gui.set_color(self.button_pause, COLORS.pause_normal)
		-- Dynamic label: "Pause" when playing, "Resume" when paused
		if self.is_paused then
			gui.set_text(self.text_pause, "Resume")
		else
			gui.set_text(self.text_pause, "Pause")
		end
	else
		gui.set_color(self.button_pause, COLORS.disabled)
		gui.set_text(self.text_pause, "Pause")
	end
end

function send_control(action)
	msg.post("example_1:/listener", "fmod_control", { action = action })
end
