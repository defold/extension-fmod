-- Example 1: spatial 3D audio.
--
-- The visual scene has a listener in the middle and a source model that follows
-- the mouse. The FMOD event is spatialized by updating listener and source
-- 3D_ATTRIBUTES every frame. This is the minimum pattern for positional audio:
-- load banks, create an event instance, set listener attributes, set event
-- attributes, then keep positions and velocities current while the event plays.
go.property("camera_url", msg.url("/camera#camera"))

local fmod_banks = require("example.fmod_banks")

-- The emitter model is moved on a horizontal plane. Mouse coordinates are
-- projected from screen space through the camera onto this Y value.
local EMITTER_Y = 0.35

local function set_attr_position(attr, dt, new_position)
	-- FMOD 3D attributes include both position and velocity. Velocity lets FMOD
	-- apply doppler and other motion-sensitive effects correctly.
	if new_position.x ~= new_position.x or attr.position.x ~= attr.position.x then
		return
	end

	local delta = new_position - attr.position
	attr.position = new_position
	attr.velocity = dt > 0 and delta * (1.0 / dt) or vmath.vector3()
end

local function screen_to_emitter_position(camera_url, x, y)
	-- Convert the 2D pointer position into a 3D ray using Defold's camera
	-- helper, then intersect that ray with the emitter plane.
	local from = camera.screen_to_world(vmath.vector3(x, y, 0), camera_url)
	local to = camera.screen_to_world(vmath.vector3(x, y, 100), camera_url)
	local ray = to - from

	if math.abs(ray.y) < 0.0001 then
		return nil
	end

	local t = (EMITTER_Y - from.y) / ray.y
	if t < 0 then
		return nil
	end

	return from + ray * t
end

local function update_emitter_from_screen(self, x, y)
	-- This only moves the visible emitter object. The audio position is computed
	-- separately in update(), which keeps the input behavior easy to understand.
	local position = screen_to_emitter_position(self.camera_url, x, y)
	if position then
		go.set_position(position, "source")
	end
end

function init(self)
	-- This script needs input for dragging the emitter and a camera projection
	-- so screen_to_world uses the same view as the rendered scene.
	msg.post(".", "acquire_input_focus")
	msg.post("@render:", "use_camera_projection")

	if not fmod then
		label.set_text("#label", "Sorry! Your platform is not yet supported.")
		return
	end

	-- The strings bank resolves event paths, and the Vehicles bank contains the
	-- Basic Engine event used as the spatial sound source.
	fmod_banks.load({ "master", "strings", "vehicles" })

	-- Event descriptions are FMOD Studio templates. Event instances are the
	-- playable runtime objects; create an instance before setting attributes.
	local event_description = fmod.studio.system:get_event("event:/Vehicles/Basic Engine")
	self.event = event_description:create_instance()

	-- Listener attributes describe the "ears" in the FMOD world. For this
	-- example the listener is represented by the center sphere.
	self.listener_attr = fmod._3D_ATTRIBUTES()
	self.listener_attr.position = go.get_world_position("listener")
	self.listener_attr.velocity = vmath.vector3()
	self.listener_attr.forward = vmath.vector3(0.0, 0.0, -1.0)
	self.listener_attr.up = vmath.vector3(0.0, 1.0, 0.0)
	fmod.studio.system:set_listener_attributes(0, self.listener_attr)

	-- Event 3D attributes describe where this event is emitted from. A 3D event
	-- will be attenuated and panned by FMOD based on its position relative to the
	-- listener.
	self.source_attr = fmod._3D_ATTRIBUTES()
	self.source_attr.position = go.get_world_position("source")
	self.source_attr.velocity = vmath.vector3()
	self.source_attr.forward = vmath.vector3(0.0, 0.0, -1.0)
	self.source_attr.up = vmath.vector3(0.0, 1.0, 0.0)
	self.event:set_3d_attributes(self.source_attr)

	-- The engine event needs a non-zero RPM so it produces a clear loop.
	self.event:set_parameter_by_name("RPM", 900.0, false)
	self.event:start()
end

function update(self, dt)
	if not fmod or not self.event then
		return
	end

	set_attr_position(self.listener_attr, dt, go.get_world_position("listener"))
	fmod.studio.system:set_listener_attributes(0, self.listener_attr)

	-- The scene controls keep the emitter under the cursor. The FMOD audio
	-- position is mirrored around the listener to match the expected stereo
	-- orientation for this camera setup without changing the visual controls.
	local visual_source_position = go.get_world_position("source")
	local audio_source_position = self.listener_attr.position - (visual_source_position - self.listener_attr.position)
	set_attr_position(self.source_attr, dt, audio_source_position)
	self.event:set_3d_attributes(self.source_attr)
end

function on_input(self, action_id, action)
	-- The input binding exposes the mouse button as "touch" for Druid, but this
	-- example also accepts "click" so it stays compatible with older bindings.
	if action_id == hash("click") or action_id == hash("touch") then
		if action.pressed then
			self.dragging = true
			update_emitter_from_screen(self, action.screen_x or action.x, action.screen_y or action.y)
			return true
		elseif action.released then
			self.dragging = false
			return true
		elseif self.dragging and action.x and action.y then
			update_emitter_from_screen(self, action.screen_x or action.x, action.screen_y or action.y)
			return true
		end
	elseif action.x and action.y then
		update_emitter_from_screen(self, action.screen_x or action.x, action.screen_y or action.y)
		return true
	end

	return false
end

function final(self)
	if not fmod then
		return
	end

	-- Release event instances when a collection proxy unloads. Banks are shared
	-- and cached in fmod_banks.lua, so they are intentionally not unloaded here.
	if self.event then
		self.event:stop(fmod.STUDIO_STOP_IMMEDIATE)
		self.event:release()
	end
end
